enum TrendGranularity {
  day
  week
  month
}

enum SlotUtilizationGroupBy {
  weekday
  date
  month
  year
}

type StatusCount {
  status: BookingStatus!
  count: Int!
}

type TypeCount {
  bookingType: BookingType!
  count: Int!
}

type BookingSummary {
  totalBookings: Int!
  byStatus: [StatusCount!]!
  byType: [TypeCount!]!
  todayAcceptedCount: Int!
  pendingCount: Int!
}

type BookingTrendPoint {
  date: Date!
  count: Int!
}

type ServicePopularity {
  serviceId: ID!
  serviceName: String!
  bookingCount: Int!
}

type UtilizationBreakdownPoint {
  label: String!
  totalSlots: Int!
  bookedSlots: Int!
}

type UtilizationSection {
  subtitle: String!
  points: [UtilizationBreakdownPoint!]!
}

type SlotUtilization {
  totalSlots: Int!
  bookedSlots: Int!
  utilizationRate: Float!
  sections: [UtilizationSection!]!
}

type StaffUtilization {
  staffId: ID
  staffName: String!
  bookings: Int!
  hoursBooked: Float!
}

type CustomerRetention {
  newCustomers: Int!
  returningCustomers: Int!
  totalCustomers: Int!
}

type ServiceCancellation {
  serviceId: ID!
  serviceName: String!
  count: Int!
}

type StaffCancellation {
  staffId: ID
  staffName: String!
  customerCount: Int!
  staffCount: Int!
}

type CancellationAnalysis {
  totalCancelled: Int!
  totalRejected: Int!
  totalCancelledOrRejected: Int!
  cancelledOrRejectedRate: Float!
  byService: [ServiceCancellation!]!
  byStaff: [StaffCancellation!]!
}

type ServiceFilterOption {
  serviceIds: [ID!]!
  serviceName: String!
  deleted: Boolean!
}

extend type Query {
  bookingSummary(from: Date!, until: Date!): BookingSummary!
  bookingTrend(from: Date!, until: Date!, granularity: TrendGranularity = day): [BookingTrendPoint!]!
  servicePopularity(from: Date!, until: Date!): [ServicePopularity!]!
  slotUtilization(from: Date!, until: Date!, groupBy: SlotUtilizationGroupBy = weekday): SlotUtilization!
  staffUtilization(from: Date!, until: Date!): [StaffUtilization!]!
  customerRetention(from: Date!, until: Date!): CustomerRetention!
  cancellationServiceOptions: [ServiceFilterOption!]!
  businessCreatedAt: Date!
  cancellationAnalysis(from: Date!, until: Date!, staffIds: [ID!], serviceIds: [ID!]): CancellationAnalysis!
}
