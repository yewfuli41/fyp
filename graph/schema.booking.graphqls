enum BookingStatus {
  ACCEPTED
  RESCHEDULED
  CANCELLED
  PAST
  REJECTED
  PENDING
}

enum BookingType {
  ONLINE
  WALK_IN
}

type Booking {
  bookingId: ID!
  userId: ID!
  user: User!
  slotOptionId: ID!
  slotOption: ServiceSlotOption!
  status: BookingStatus
  bookingType: BookingType!
  description: String
  deletedAt: DateTime
  createdAt: DateTime!
  decidedAt: DateTime
  decidedBy: ID
  decidedByUser: User
}

type BookingDetail {
  bookingId: ID!
  status: BookingStatus!
  bookingType: BookingType!
  serviceSlotId: ID!
  slotOptionId: ID!
  serviceOptionId: ID!
  date: Date!
  startTime: Time!
  endTime: Time!
  serviceName: String!
  optionName: String!
  staffName: String
  customerName: String!
  customerEmail: String!
  businessId: ID!
  businessName: String!
  description: String
  createdAt: DateTime!
}

input WalkInInput {
  serviceOptionId: ID!
  staffId: ID
  date: Date!
  startTime: Time!
  endTime: Time!
}

extend type Query {
  publicBusinesses: [BusinessProfile!]!
  publicServices(businessId: ID!): [Service!]!
  publicStaff(businessId: ID!): [Staff!]!

  availableSlots(businessId: ID!, serviceOptionId: ID!, date: Date!, staffId: ID, unassignedOnly: Boolean, unavailableStaffId: ID, unavailableFrom: Date, unavailableUntil: Date): [ServiceSlot!]!
  availableDates(businessId: ID!, serviceId: ID, serviceOptionId: ID, staffId: ID, unassignedOnly: Boolean, from: Date!, until: Date!, unavailableStaffId: ID, unavailableFrom: Date, unavailableUntil: Date): [Date!]!

  recentlyBookedBusinesses: [BusinessProfile!]!
  businessBookings: [BookingDetail!]!
  myAppointments: [BookingDetail!]!
}

extend type Mutation {
  createBooking(slotOptionId: ID!, description: String): Booking!

  acceptBooking(bookingId: ID!): BookingDetail!
  rejectBooking(bookingId: ID!): BookingDetail!
  cancelBooking(bookingId: ID!): BookingDetail!
  rescheduleBooking(bookingId: ID!, newSlotOptionId: ID!): BookingDetail!
  acceptReschedule(bookingId: ID!): BookingDetail!

  updateBookingDescription(bookingId: ID!, description: String): BookingDetail!
  recordWalkIn(input: WalkInInput!): BookingDetail!
}
