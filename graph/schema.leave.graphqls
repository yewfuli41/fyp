enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

type LeaveApplication {
  leaveId: ID!
  staffId: ID!
  staff: Staff!
  staffName: String!
  position: String
  startDate: Date!
  endDate: Date!
  justification: String
  fileUrl: String
  status: LeaveStatus!
  remark: String
  decidedAt: DateTime
  deletedAt: DateTime
  createdAt: DateTime!
  affectedBookings: [BookingDetail!]!
}

input ApplyLeaveInput {
  startDate: Date!
  endDate: Date!
  justification: String
  fileUrl: String
}

input SlotReassignmentInput {
  serviceSlotId: ID!
  staffId: ID
}

input LeaveRescheduleInput {
  bookingId: ID!
  newSlotOptionId: ID!
}

extend type Query {
  myLeaveApplications: [LeaveApplication!]!
  businessLeaveApplications: [LeaveApplication!]!
  staffHoursConflicts(staffId: ID!, workingHours: [WorkingHourInput!]!): [ServiceSlot!]!
}

extend type Mutation {
  applyLeave(input: ApplyLeaveInput!): LeaveApplication!
  updateLeaveApplication(leaveId: ID!, justification: String): LeaveApplication!
  deleteLeaveApplication(leaveId: ID!): Boolean!
  approveLeaveApplication(leaveId: ID!, reschedules: [LeaveRescheduleInput!]): LeaveApplication!
  rejectLeaveApplication(leaveId: ID!, remark: String!): LeaveApplication!
  updateStaffWorkingHours(staffId: ID!, workingHours: [WorkingHourInput!]!, reassignments: [SlotReassignmentInput!]!): Staff!
}
