type Service {
  serviceId: ID!
  businessId: ID!
  business: BusinessProfile!
  serviceName: String!
  description: String
  serviceOptions: [ServiceOption!]!
  deletedAt: DateTime
}

type ServiceOption {
  serviceOptionId: ID!
  serviceId: ID!
  service: Service!
  serviceOptionName: String!
  description: String
  serviceOptionItems: [ServiceOptionItem!]!
  serviceSlotOptions: [ServiceSlotOption!]!
  recurringSchedules: [RecurringSchedule!]!
  # true when no version of this option's group is effective today (e.g. a
  # brand-new option whose bounded window hasn't started, or has ended).
  removed: Boolean!
  effectiveFrom: Date
  effectiveUntil: Date
  # true once anything has ever booked this option — exactly what blocks
  # deleting it (see updateService). Lets the client refuse a delete
  # immediately instead of only finding out after a full form submit.
  hasBooking: Boolean!
  deletedAt: DateTime
}

type ServiceOptionItem {
  serviceOptionItemId: ID!
  serviceOptionId: ID!
  servicePackage: ServiceOption!
  serviceOptionItemName: String!
  deletedAt: DateTime
}

input ServiceOptionItemInput {
  serviceOptionItemName: String!
}

input ServiceOptionInput {
  # Set when editing an existing option. Its name/items can't be changed in
  # place — delete it (it must have no booking) and add a replacement instead.
  # Omit/null serviceOptionId (and the dates) when adding a brand new option.
  serviceOptionId: ID
  serviceOptionName: String!
  description: String
  serviceOptionItems: [ServiceOptionItemInput!]!
  # For a brand new option: when it starts (effectiveFrom, defaults to today)
  # and an optional bounded end (effectiveUntil). For an existing, unchanged
  # option: a new start and/or end date to resize its window to (today or
  # later only) — the default option can't be given an end date.
  effectiveFrom: Date
  effectiveUntil: Date
  # true to explicitly clear an existing option's already-saved effectiveUntil
  # (reopening it) without setting a new one. effectiveUntil alone can't
  # express "clear it" since blank and "not set this time" serialize
  # identically.
  clearEffectiveUntil: Boolean
}

input ServiceInput {
  serviceName: String!
  description: String
  serviceOptions: [ServiceOptionInput!]!
}

extend type Query {
  displayServices: [Service!]!
}

extend type Mutation {
  createService(service: ServiceInput!): Service!
  updateService(serviceId: ID!, service: ServiceInput!): Service!
  deleteService(serviceId: ID!): Boolean!
}
