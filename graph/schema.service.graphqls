type Service {
  serviceId: ID!
  businessId: ID!
  business: BusinessProfile!
  serviceName: String!
  description: String
  serviceOptions: [ServiceOption!]!
  deletedAt: DateTime
}

type ServiceOption {
  serviceOptionId: ID!
  serviceId: ID!
  service: Service!
  serviceOptionName: String!
  description: String
  serviceOptionItems: [ServiceOptionItem!]!
  serviceSlotOptions: [ServiceSlotOption!]!
  recurringSchedules: [RecurringSchedule!]!
  removed: Boolean!
  effectiveFrom: Date
  effectiveUntil: Date
  hasBooking: Boolean!
  deletedAt: DateTime
}

type ServiceOptionItem {
  serviceOptionItemId: ID!
  serviceOptionId: ID!
  servicePackage: ServiceOption!
  serviceOptionItemName: String!
  deletedAt: DateTime
}

input ServiceOptionItemInput {
  serviceOptionItemName: String!
}

input ServiceOptionInput {
  serviceOptionId: ID
  serviceOptionName: String!
  description: String
  serviceOptionItems: [ServiceOptionItemInput!]!
  # Only meaningful when creating an option (no serviceOptionId). An existing
  # option's effective window is immutable, so sending either date with a
  # serviceOptionId is rejected rather than applied.
  effectiveFrom: Date
  effectiveUntil: Date
  # Deprecated: used to clear a saved effectiveUntil. Now always rejected —
  # kept so older clients get that error instead of an unknown-field failure.
  clearEffectiveUntil: Boolean
}

input ServiceInput {
  serviceName: String!
  description: String
  serviceOptions: [ServiceOptionInput!]!
}

extend type Query {
  displayServices: [Service!]!
}

extend type Mutation {
  createService(service: ServiceInput!): Service!
  updateService(serviceId: ID!, service: ServiceInput!): Service!
  deleteService(serviceId: ID!): Boolean!
}
