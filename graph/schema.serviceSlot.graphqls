input ServiceSlotInput {
  staffId: ID
  date: Date                 # a single specific date, OR ...
  daysOfWeek: [DayOfWeek!]   # ... recurring weekdays (mutually exclusive)
  startTime: Time!
  endTime: Time!
  serviceOptionIds: [ID!]!
}

extend type Query {
  displayServiceSlots(date: Date!, staffId: ID, serviceId: ID, unassignedOnly: Boolean): [ServiceSlot!]!
  availableStaffForSlot(serviceSlotId: ID!): [Staff!]!
}

extend type Mutation {
  createServiceSlot(input: ServiceSlotInput!): ServiceSlot!
  # applyToFutureRecurring mirrors deleteServiceSlot's flag: false edits just this
  # occurrence; true edits it plus every future occurrence sharing its staff/time/
  # weekday, replacing them with the (possibly newly recurring) schedule in input.
  # Blocked entirely once any affected occurrence already has a booking — only
  # reassignServiceSlotStaff remains available for those.
  updateServiceSlot(serviceSlotId: ID!, input: ServiceSlotInput!, applyToFutureRecurring: Boolean!): ServiceSlot!
  reassignServiceSlotStaff(serviceSlotId: ID!, staffId: ID): ServiceSlot!
  deleteServiceSlot(serviceSlotId: ID!, deleteFutureRecurring: Boolean!): Boolean!
}
