type ServiceSlot {
  serviceSlotId: ID!
  staffId: ID
  staff: Staff
  date: Date!
  startTime: Time!
  endTime: Time!
  serviceSlotOptions: [ServiceSlotOption!]!
  hasBooking: Boolean!
  deletedAt: DateTime
  createdAt: DateTime!
  createdBy: ID
  creator: User
}

type ServiceSlotOption {
  slotOptionId: ID!
  serviceOptionId: ID!
  serviceOption: ServiceOption!
  serviceSlotId: ID!
  serviceSlot: ServiceSlot!
  bookings: [Booking!]!
  deletedAt: DateTime
}

type RecurringSchedule {
  recurringScheduleId: ID!
  staffId: ID!
  staff: Staff!
  serviceOptionId: ID!
  serviceOption: ServiceOption!
  day: DayOfWeek!
  startTime: Time!
  endTime: Time!
  deletedAt: DateTime
  createdAt: DateTime!
  createdBy: ID
  creator: User
}

input ServiceSlotInput {
  staffId: ID
  date: Date
  daysOfWeek: [DayOfWeek!]
  recurringEndDate: Date
  startTime: Time!
  endTime: Time!
  serviceOptionIds: [ID!]!
}

extend type Query {
  displayServiceSlots(date: Date!, staffId: ID, serviceId: ID, unassignedOnly: Boolean): [ServiceSlot!]!
  availableStaffForSlot(serviceSlotId: ID!): [Staff!]!
  recurringDefaultWeeks: Int!
}

extend type Mutation {
  createServiceSlot(input: ServiceSlotInput!): ServiceSlot!
  updateServiceSlot(serviceSlotId: ID!, input: ServiceSlotInput!): ServiceSlot!
  reassignServiceSlotStaff(serviceSlotId: ID!, staffId: ID): ServiceSlot!
  deleteServiceSlot(serviceSlotId: ID!, deleteFutureRecurring: Boolean!): Boolean!
}
