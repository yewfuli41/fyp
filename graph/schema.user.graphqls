type User {
  userId: ID!
  username: String!
  email: String!
  contactNumber: String!
  failedLoginAttempts: Int!
  lockedUntil: DateTime
  mustResetPassword: Boolean!
  businessProfile: BusinessProfile
  staffProfile: Staff
  bookings: [Booking!]!
}

type AuthPayload {
  token: String!
  user: User!
}

input SignUpInput {
  username: String!
  email: String!
  contactNumber: String!
  password: String!
}

input LogInInput{
  email: String!
  password: String!
}

input UpdateProfileInput{
  username: String!
  email: String!
  contactNumber: String
}

extend type Query {
  userProfile: User
}

extend type Mutation {
  signUp(user: SignUpInput!): AuthPayload!
  logIn(user: LogInInput!): AuthPayload!
  resetPassword(newPassword: String!): Boolean!
  # A logged-in user voluntarily changing their own password from the
  # profile page — requires the current password, unlike resetPassword.
  changePassword(currentPassword: String!, newPassword: String!): Boolean!
  updateProfile(user: UpdateProfileInput!): User!
}
